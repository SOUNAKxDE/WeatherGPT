# Copy this file to .env.local (Vercel) and fill in real values.
# Never commit the real .env.local / .env — only this example file.

# Optional. Without it, /api/translate falls back to the free, keyless
# MyMemory API (lower quality, ~5,000 words/day per IP). With it, Google
# Cloud Translation API v2 is used instead. See the setup steps in the
# comment at the top of api/translate.js.
GOOGLE_TRANSLATE_API_KEY=
